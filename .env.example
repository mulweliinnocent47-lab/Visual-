# Copy to .env and fill in the values from your Supabase project (Settings > API).
# Only publishable values belong here: everything prefixed VITE_ is shipped to the browser.
# Never put a service role key or an AI key in this file.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
